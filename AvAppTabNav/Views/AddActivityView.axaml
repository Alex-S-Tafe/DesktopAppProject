<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AvAppTabNav.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvAppTabNav.Views.AddActivityView"
             xmlns:vm="clr-namespace:AvAppTabNav.ViewModels"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="10">
        <TabControl>
            <TabItem Header="Fitness">
                <views:AddFitnessView DataContext="{Binding AddFitness}"/>
            </TabItem>
            <TabItem Header="Entertainment">
                <views:AddEntertainmentView DataContext="{Binding AddEntertainment}"/>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
